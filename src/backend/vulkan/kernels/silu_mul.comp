#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = BINARY_THREADS) in;
layout(push_constant, std430) uniform PC { uint64_t gate; uint64_t up; uint64_t y; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = F32Buf(pc.gate).v[i];
    F32Buf(pc.y).v[i] = (g / (1.0 + exp(-g))) * F32Buf(pc.up).v[i];
}
