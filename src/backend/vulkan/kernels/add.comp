#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = BINARY_THREADS) in;
layout(push_constant, std430) uniform PC { uint64_t a; uint64_t b; uint64_t y; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    F32Buf(pc.y).v[i] = F32Buf(pc.a).v[i] + F32Buf(pc.b).v[i];
}
