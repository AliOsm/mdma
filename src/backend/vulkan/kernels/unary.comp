#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = UNARY_THREADS) in;
layout(push_constant, std430) uniform PC { uint64_t x; uint n; float value; uint op; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    F32Buf x = F32Buf(pc.x);
    x.v[i] = pc.op == UNARY_SCALE ? x.v[i] * pc.value : tanh(x.v[i] / pc.value) * pc.value;
}
