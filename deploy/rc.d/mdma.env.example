# Sourced by rc.d as root. Keep root-owned, mode 0600; use shell quoting.
MDMA_MODELS_DIR="/var/db/mdma/models"
MDMA_LISTEN="127.0.0.1:6362"
MDMA_TLS_CERT="/usr/local/etc/mdma/server.pem"
MDMA_TLS_KEY="/usr/local/etc/mdma/server-key.pem"
MDMA_TLS_CA="/usr/local/etc/mdma/ca.pem"
MDMA_BACKEND="cpu"
MDMA_N_CTX="4096"
MDMA_WARMUP_ROUNDS="2"
MDMA_SHUTDOWN_TIMEOUT_SECS="30"
