# systemd EnvironmentFile for mdma-web.service. Keep private and user-owned.
# Replace /home/YOUR_USER. The capability URL is printed to the journal:
#   journalctl --user -u mdma-web | grep 'listening on'
MDMA_WEB_LISTEN=127.0.0.1:6364
MDMA_ADDR=localhost:6362
MDMA_TLS_CERT=/home/YOUR_USER/.config/mdma/tls/client/client.pem
MDMA_TLS_KEY=/home/YOUR_USER/.config/mdma/tls/client/client-key.pem
MDMA_TLS_CA=/home/YOUR_USER/.config/mdma/tls/client/ca.pem
