# Sourced by the mdma wrapper as your user. Keep private and user-owned.
# Replace /home/YOUR_USER. Use shell quoting for paths containing spaces.
MDMA_ADDR=localhost:50051
MDMA_TLS_CERT=/home/YOUR_USER/.config/mdma/tls/client/client.pem
MDMA_TLS_KEY=/home/YOUR_USER/.config/mdma/tls/client/client-key.pem
MDMA_TLS_CA=/home/YOUR_USER/.config/mdma/tls/client/ca.pem
MDMA_READY_TIMEOUT_SECS=${MDMA_READY_TIMEOUT_SECS-120}
