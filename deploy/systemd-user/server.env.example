# systemd EnvironmentFile syntax: use absolute literal paths, no shell expansion.
# Replace /home/YOUR_USER and the model path before enabling the service.
MDMA_GGUF_PATH=/home/YOUR_USER/models/model.gguf
MDMA_LISTEN=127.0.0.1:50051
MDMA_BACKEND=cpu
MDMA_N_CTX=4096
MDMA_TLS_CERT=/home/YOUR_USER/.config/mdma/tls/server/server.pem
MDMA_TLS_KEY=/home/YOUR_USER/.config/mdma/tls/server/server-key.pem
MDMA_TLS_CA=/home/YOUR_USER/.config/mdma/tls/server/ca.pem
MDMA_WARMUP_ROUNDS=2
MDMA_SHUTDOWN_TIMEOUT_SECS=30
MDMA_POWER=auto
# Prepared Q4_K is ROCm-only and experimental; prepare and validate before opting in.
MDMA_CACHE=off
MDMA_CACHE_DIR=/home/YOUR_USER/.cache/mdma
# For ROCm: build with --features rocm, set MDMA_BACKEND=rocm, and if needed:
# LD_LIBRARY_PATH=/opt/rocm/lib
# ROCm GPU-only f32 reference mode (no WMMA/int8 or graph execution).
# MDMA_HIP_F32=1
