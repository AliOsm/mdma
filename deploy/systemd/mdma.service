[Unit]
Description=MDMA mTLS inference server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mdma
Group=mdma
EnvironmentFile=/etc/mdma/mdma.env
Environment=HOME=/var/lib/mdma
ExecStart=/usr/local/bin/mdma-serve
WorkingDirectory=/var/lib/mdma
StateDirectory=mdma
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillSignal=SIGTERM
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdma

[Install]
WantedBy=multi-user.target
